---
import TagPosts from "@/components/tags/tag-posts.astro";
import Layout from "@/layouts/site-layout.astro";
import {
  BLOG_POST_RESERVED_TAG,
  collectVisibleBlogTags,
  getListedBlogPostsWithGitDates,
  toTagPostItem,
} from "@/lib/blog-posts";

export async function getStaticPaths() {
  const allPosts = await getListedBlogPostsWithGitDates();

  const contentTags = collectVisibleBlogTags(allPosts);
  const uniqueTags = [BLOG_POST_RESERVED_TAG, ...contentTags];

  return uniqueTags.map((tag) => {
    const filteredPosts =
      tag === BLOG_POST_RESERVED_TAG
        ? allPosts
        : allPosts.filter((post) => post.data.tags && post.data.tags.includes(tag));

    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const tag = Astro.params.tag ?? BLOG_POST_RESERVED_TAG;
const { posts } = Astro.props;
const isAllPosts = tag === BLOG_POST_RESERVED_TAG;
const pageTitle = isAllPosts ? "Tous les articles" : `Articles avec le tag « ${tag} »`;
const tagPosts = posts.map(toTagPostItem);
---

<Layout title={pageTitle} bodyClass="tag-page" readingProgress={false}>
  <Fragment slot="content">
    <section aria-labelledby="tag-posts-title">
      <h1 id="tag-posts-title">{pageTitle}</h1>
      <TagPosts posts={tagPosts} tag={tag} view="table" />
    </section>
  </Fragment>
</Layout>
