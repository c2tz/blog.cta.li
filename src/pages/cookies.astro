---
import { CookiePreferencesComponent } from "@/components/feedback/cookie-preferences.component";
import Layout from "@/layouts/site-layout.astro";
import {
  SITE_COOKIE_NAMES,
  SITE_EVENTS,
  SITE_LEGACY_COOKIE_NAMES,
  SITE_LEGACY_STORAGE_KEYS,
  SITE_STORAGE_KEYS,
} from "@/lib/site-contracts";

const cookiePreferenceFallbackConfig = {
  consentCookieName: SITE_COOKIE_NAMES.cookieConsent,
  consentEvent: SITE_EVENTS.consentChange,
  consentStorageKey: SITE_STORAGE_KEYS.cookieConsent,
  legacyConsentCookieName: SITE_LEGACY_COOKIE_NAMES.cookieConsent,
  legacyConsentStorageKey: SITE_LEGACY_STORAGE_KEYS.cookieConsent,
};
---

<Layout
  title="Données personnelles"
  description="Détails sur les cookies, le stockage local et les services utilisés par ct-blog."
>
  <Fragment slot="content">
    <article class="site-prose" aria-labelledby="cookies-title">
      <h1 id="cookies-title">Données personnelles</h1>

      <p>
        Cette page détaille les cookies, le stockage local et les services utilisés par ct-blog.
        L’objectif est de garder les préférences utiles au fonctionnement du site sans multiplier
        les traceurs.
      </p>

      <h2 id="stockage-necessaire-au-site">
        <a href="#stockage-necessaire-au-site" class="heading-link">Stockage nécessaire au site</a>
      </h2>
      <p>
        Le site conserve certaines préférences dans votre navigateur pour éviter de vous redemander
        les mêmes choix à chaque visite.
      </p>
      <ul>
        <li>
          <code>ct-cookie-consent</code> et <code>ct-cookie-consent-v1</code> mémorisent votre choix d’autoriser
          ou de refuser les services optionnels.
        </li>
        <li>
          <code>ct-explicit-content-ack</code> et <code>ct-explicit-content-ack-v1</code> mémorisent l’avertissement
          relatif aux images pouvant être réservées à un public adulte.
        </li>
        <li>
          <code>site-theme-preference</code> garde le thème choisi: clair, sombre ou système.
        </li>
        <li>
          <code>home-detail-view-v1</code> garde le choix d’affichage détaillé ou compact de la page d’accueil.
        </li>
      </ul>

      <h2 id="fonctionnalites-locales">
        <a href="#fonctionnalites-locales" class="heading-link">Fonctionnalités locales</a>
      </h2>
      <p>
        Certaines options améliorent l’expérience sans créer de compte utilisateur. Les fonds
        Konachan de la page d’accueil, leur préférence de classement et la géolocalisation IP
        affichée dans le pied de page peuvent être mis en cache dans le navigateur.
      </p>
      <ul>
        <li>
          <code>home-konachan-backgrounds-v8</code> conserve temporairement la liste des images chargées
          pour l’accueil.
        </li>
        <li>
          <code>home-konachan-rating-preference-v1</code> garde la préférence de classement des images
          d’accueil.
        </li>
        <li>
          <code>site-ip-geolocation-v2</code> garde temporairement le résultat de géolocalisation IP afin
          de limiter les appels réseau répétés.
        </li>
      </ul>

      <h2 id="services-externes">
        <a href="#services-externes" class="heading-link">Services externes</a>
      </h2>
      <p>
        Le site peut contacter des services externes uniquement pour les fonctionnalités visibles:
        récupérer une géolocalisation IP, charger les commentaires Giscus sur les articles, ou
        mesurer les performances de navigation en production via Vercel Speed Insights.
      </p>
      <p>
        Ces trois services ne sont chargés qu’après votre accord. Si vous refusez, l’adresse IP
        disparaît du pied de page, Giscus n’est pas chargé et Vercel Speed Insights reste inactif.
      </p>

      <h2 id="modifier-vos-choix-cookies">
        <a href="#modifier-vos-choix-cookies" class="heading-link">Modifier vos choix cookies</a>
      </h2>
      <p>
        Le panneau ci-dessous permet de modifier ou de réinitialiser le choix lié aux services
        optionnels. Vous pouvez aussi supprimer toutes les données depuis les réglages de votre
        navigateur en effaçant les cookies et les données de site associées à
        <code>ct-blog.cta.li</code>.
      </p>

      <CookiePreferencesComponent client:load />

      <noscript>
        <section class="cookie-preferences-panel cookie-preferences-fallback not-prose">
          <h2>Choix cookies indisponible</h2>
          <p class="cookie-preferences-fallback-note">
            JavaScript est désactivé dans votre navigateur. Le panneau interactif ne peut donc pas
            enregistrer votre choix depuis cette page.
          </p>
          <p>
            Vous pouvez continuer à utiliser le site sans services optionnels, ou modifier vos
            données depuis les réglages de votre navigateur en supprimant les cookies et les données
            associées à <code>ct-blog.cta.li</code>.
          </p>
        </section>
      </noscript>

      <section
        class="cookie-preferences-panel cookie-preferences-fallback not-prose"
        data-cookie-preferences-fallback
        hidden
        aria-label="Choix cookies de secours"
      >
        <p class="cookie-preferences-fallback-note">
          Le panneau interactif n’a pas chargé. Vous pouvez tout de même modifier votre choix ici.
        </p>
        <div
          class="cookie-preferences-fallback-actions"
          role="group"
          aria-label="Choix des services optionnels"
        >
          <button type="button" data-cookie-preference-choice="accepted">Autoriser</button>
          <button type="button" data-cookie-preference-choice="rejected">Refuser</button>
          <button type="button" data-cookie-preference-choice="unset">Réinitialiser</button>
        </div>
        <p class="cookie-preferences-feedback" role="status" aria-live="polite"></p>
      </section>

      <script define:vars={{ cookiePreferenceFallbackConfig }}>
        const controlsSelector = "mat-button-toggle-group, .mat-button-toggle-group";

        function fallbackPanel() {
          return document.querySelector("[data-cookie-preferences-fallback]");
        }

        function fallbackButtons() {
          return [...(fallbackPanel()?.querySelectorAll("[data-cookie-preference-choice]") ?? [])];
        }

        function hasMountedPreferences() {
          return Boolean(document.querySelector(controlsSelector));
        }

        function syncFallbackVisibility() {
          const fallback = fallbackPanel();
          if (!fallback) return;
          fallback.hidden = hasMountedPreferences();
        }

        function writeCookie(name, value) {
          document.cookie = [
            `${encodeURIComponent(name)}=${encodeURIComponent(value)}`,
            "Max-Age=31536000",
            "Path=/",
            "SameSite=Lax",
          ].join("; ");
        }

        function expireCookie(name) {
          document.cookie = `${encodeURIComponent(name)}=; Max-Age=0; Path=/; SameSite=Lax`;
        }

        function setSelectedFallback(choice) {
          for (const button of fallbackButtons()) {
            const selected = button.dataset.cookiePreferenceChoice === choice;
            button.toggleAttribute("data-selected", selected);
            button.setAttribute("aria-pressed", String(selected));
          }
        }

        function updateConsent(choice) {
          const fallback = fallbackPanel();
          const feedback = fallback?.querySelector(".cookie-preferences-feedback");
          if (!fallback || !feedback) return;

          try {
            if (choice === "unset") {
              localStorage.removeItem(cookiePreferenceFallbackConfig.consentStorageKey);
              localStorage.removeItem(cookiePreferenceFallbackConfig.legacyConsentStorageKey);
            } else {
              const state = {
                functionality: choice === "accepted",
                updatedAt: new Date().toISOString(),
                version: 1,
              };
              localStorage.setItem(
                cookiePreferenceFallbackConfig.consentStorageKey,
                JSON.stringify(state),
              );
              localStorage.removeItem(cookiePreferenceFallbackConfig.legacyConsentStorageKey);
            }
          } catch {}

          if (choice === "unset") {
            expireCookie(cookiePreferenceFallbackConfig.consentCookieName);
          } else {
            writeCookie(cookiePreferenceFallbackConfig.consentCookieName, choice);
          }

          expireCookie(cookiePreferenceFallbackConfig.legacyConsentCookieName);
          setSelectedFallback(choice);
          feedback.textContent =
            choice === "unset" ? "Choix cookies réinitialisé." : "Choix cookies mis à jour.";
          document.dispatchEvent(new Event(cookiePreferenceFallbackConfig.consentEvent));

          if (choice === "unset") {
            window.setTimeout(() => {
              if (fallback.hidden) return;
              setSelectedFallback("");
            }, 2200);
          }
        }

        function initFallback() {
          const fallback = fallbackPanel();
          if (!fallback || fallback.dataset.cookiePreferencesFallbackReady === "true") return;

          fallback.dataset.cookiePreferencesFallbackReady = "true";
          fallback.addEventListener("click", (event) => {
            const button =
              event.target instanceof Element
                ? event.target.closest("[data-cookie-preference-choice]")
                : null;
            if (!(button instanceof HTMLElement)) return;

            const choice = button.dataset.cookiePreferenceChoice;
            if (choice === "accepted" || choice === "rejected" || choice === "unset") {
              updateConsent(choice);
            }
          });

          const observer = new MutationObserver(syncFallbackVisibility);
          observer.observe(document.body, { childList: true, subtree: true });

          syncFallbackVisibility();
          requestAnimationFrame(syncFallbackVisibility);
          window.setTimeout(syncFallbackVisibility, 500);
          window.setTimeout(syncFallbackVisibility, 1500);
          window.setTimeout(syncFallbackVisibility, 3000);
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initFallback, { once: true });
        } else {
          initFallback();
        }

        document.addEventListener("astro:page-load", initFallback);
      </script>
    </article>
  </Fragment>
</Layout>
