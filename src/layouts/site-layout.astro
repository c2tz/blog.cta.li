---
import { SITE_ARTICLE_TITLE_PREFIX, SITE_DESCRIPTION, SITE_DEFAULT_TITLE } from "@/site-config";

import Seo, { type OpenGraphData } from "@/components/layout/seo.astro";
import Footer from "@/components/layout/site-footer.astro";
import Header from "@/components/layout/site-header.astro";
import CookieConsentBanner from "@/components/feedback/cookie-consent-banner.astro";
import PageLoadingIndicator from "@/components/feedback/page-loading-indicator.astro";
import SiteTooltip from "@/components/feedback/site-tooltip.astro";
import ImagePreview from "@/components/image-preview/image-preview.astro";
import ScrollTopButton from "@/components/navigation/scroll-top-button.astro";
import {
  MATERIAL_DYNAMIC_COLOR_ROLES,
  SITE_COOKIE_NAMES,
  SITE_LEGACY_COOKIE_NAMES,
  SITE_LEGACY_STORAGE_KEYS,
  SITE_STORAGE_KEYS,
} from "@/lib/site-contracts";
import { computeRoute } from "@vercel/speed-insights";
import speedInsightsPackage from "@vercel/speed-insights/package.json";
import "@/assets/css/global.scss";

interface Props {
  locale?: string;
  title?: string;
  description?: string;
  bodyClass?: string;
  readingProgress?: boolean;
  contentEnhancements?: boolean;
  barePage?: boolean;
  openGraph?: OpenGraphData;
  structuredData?: Record<string, unknown> | readonly Record<string, unknown>[];
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const STATIC_ASSET_VERSION = "20260704";

const {
  locale = "fr",
  title,
  description,
  bodyClass,
  readingProgress = true,
  contentEnhancements,
  barePage = false,
  openGraph,
  structuredData,
} = Astro.props as Props;

const seoTitle = title ? `${SITE_ARTICLE_TITLE_PREFIX} ${title}` : SITE_DEFAULT_TITLE;
const seoDescription = description ?? SITE_DESCRIPTION;
const themeStorageKey = SITE_STORAGE_KEYS.themePreference;
const legacyThemeStorageKey = SITE_LEGACY_STORAGE_KEYS.themePreference;
const detailStorageKey = SITE_STORAGE_KEYS.homeDetailView;
const dynamicColorEnabledStorageKey = SITE_STORAGE_KEYS.materialDynamicColorEnabled;
const dynamicColorPaletteStorageKey = SITE_STORAGE_KEYS.materialDynamicColorPalette;
const dynamicColorRoles = MATERIAL_DYNAMIC_COLOR_ROLES;
const explicitContentCookieName = SITE_COOKIE_NAMES.explicitContentAcknowledgement;
const explicitContentStorageKey = SITE_STORAGE_KEYS.explicitContentAcknowledgement;
const legacyDetailStorageKey = SITE_LEGACY_STORAGE_KEYS.homeDetailView;
const detailCookieName = SITE_COOKIE_NAMES.homeDetailView;
const legacyDetailCookieName = SITE_LEGACY_COOKIE_NAMES.homeDetailView;
const isPost = Astro.url.pathname.startsWith("/posts/");
const shouldEnhanceContent = contentEnhancements ?? isPost;
const shouldLoadSpeedInsights =
  import.meta.env.PROD && process.env.VERCEL === "1" && process.env.VERCEL_ENV === "production";
const speedInsightsParams = Object.fromEntries(
  Object.entries(Astro.params).filter((entry): entry is [string, string] => entry[1] !== undefined),
);
const speedInsightsRoute = computeRoute(Astro.url.pathname, speedInsightsParams);
const speedInsightsVersion = speedInsightsPackage.version;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <script
      is:inline
      define:vars={{
        detailCookieName,
        detailStorageKey,
        dynamicColorEnabledStorageKey,
        dynamicColorPaletteStorageKey,
        dynamicColorRoles,
        legacyDetailCookieName,
        legacyDetailStorageKey,
        legacyThemeStorageKey,
        themeStorageKey,
      }}
    >
      (() => {
        const root = document.documentElement;
        const colorPattern = /^#[0-9a-f]{6}$/i;
        const systemTheme = matchMedia("(prefers-color-scheme: dark)");

        const syncThemePreference = () => {
          try {
            const key = themeStorageKey;
            const legacyKey = legacyThemeStorageKey;
            const preferences = ["system", "light", "dark"];
            const stored = localStorage.getItem(key);
            const legacyStored = localStorage.getItem(legacyKey);
            const preference = preferences.includes(stored)
              ? stored
              : preferences.includes(legacyStored)
                ? legacyStored
                : "system";

            if (stored === null && preferences.includes(legacyStored)) {
              localStorage.setItem(key, preference);
              localStorage.removeItem(legacyKey);
            }

            const resolved =
              preference === "system" ? (systemTheme.matches ? "dark" : "light") : preference;

            root.dataset.theme = resolved;
            root.dataset.themePreference = preference;
            root.style.colorScheme = resolved;
            return resolved;
          } catch {
            root.dataset.theme = "light";
            root.dataset.themePreference = "system";
            root.style.colorScheme = "light";
            return "light";
          }
        };

        const syncDetailView = () => {
          const readCookie = (name) => {
            const encodedName = `${encodeURIComponent(name)}=`;
            const cookie = document.cookie
              .split(";")
              .map((part) => part.trim())
              .find((part) => part.startsWith(encodedName));

            if (!cookie) return null;

            try {
              return decodeURIComponent(cookie.slice(encodedName.length));
            } catch {
              return null;
            }
          };
          const normalizeDetailView = (value) => {
            if (value === "true" || value === "detailed") return true;
            if (value === "false" || value === "compact") return false;
            return null;
          };
          try {
            const stored = localStorage.getItem(detailStorageKey);
            const legacyStored = localStorage.getItem(legacyDetailStorageKey);
            const candidates = [
              stored,
              legacyStored,
              readCookie(detailCookieName),
              readCookie(legacyDetailCookieName),
            ];
            const detailed =
              candidates.map(normalizeDetailView).find((value) => value !== null) ?? false;

            if (stored === null && legacyStored !== null) {
              const normalizedLegacy = normalizeDetailView(legacyStored);
              if (normalizedLegacy !== null) {
                localStorage.setItem(detailStorageKey, normalizedLegacy ? "true" : "false");
                localStorage.removeItem(legacyDetailStorageKey);
              }
            }

            if (detailed) root.dataset.homeDetailView = "true";
            else delete root.dataset.homeDetailView;
            return detailed;
          } catch {
            delete root.dataset.homeDetailView;
            return false;
          }
        };

        const clearDynamicColor = () => {
          root.style.removeProperty("--md-source-color");
          root.style.removeProperty("--home-hero-initial-on-image");
          root.style.removeProperty("--home-hero-initial-on-image-muted");
          for (const role of dynamicColorRoles) {
            root.style.removeProperty(`--md-sys-color-${role}`);
          }
          delete root.dataset.materialDynamicColor;
          delete root.dataset.materialDynamicColorSource;
        };

        const syncDynamicColor = (theme, detailed) => {
          clearDynamicColor();

          try {
            const enabled = localStorage.getItem(dynamicColorEnabledStorageKey) === "true";
            root.toggleAttribute("data-material-dynamic-color-preference", enabled);
            if (!enabled || !detailed) return;

            const palette = JSON.parse(
              localStorage.getItem(dynamicColorPaletteStorageKey) || "null",
            );
            const sourceColor = palette?.sourceColor;
            const schemes = palette?.schemes;
            const validPalette =
              palette?.version === 1 &&
              colorPattern.test(sourceColor) &&
              dynamicColorRoles.every(
                (role) =>
                  colorPattern.test(schemes?.light?.[role]) &&
                  colorPattern.test(schemes?.dark?.[role]),
              );
            if (!validPalette) return;

            root.dataset.materialDynamicColor = "true";
            root.dataset.materialDynamicColorSource = sourceColor;
            root.style.setProperty("--md-source-color", sourceColor);
            root.style.setProperty("--home-hero-initial-on-image", schemes.dark.primary);
            root.style.setProperty("--home-hero-initial-on-image-muted", schemes.dark.secondary);
            for (const role of dynamicColorRoles) {
              root.style.setProperty(`--md-sys-color-${role}`, schemes[theme][role]);
            }
          } catch {
            root.removeAttribute("data-material-dynamic-color-preference");
            clearDynamicColor();
          }
        };

        const syncPageAppearance = () => {
          const theme = syncThemePreference();
          const detailed = syncDetailView();
          syncDynamicColor(theme, detailed);
        };

        syncPageAppearance();
        addEventListener("pageshow", syncPageAppearance);
        systemTheme.addEventListener("change", () => {
          if (root.dataset.themePreference === "system") syncPageAppearance();
        });
        addEventListener("storage", (event) => {
          if (
            event.key === null ||
            event.key === themeStorageKey ||
            event.key === legacyThemeStorageKey
          ) {
            syncPageAppearance();
          }
        });
      })();
    </script>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href={`/favicon.ico?v=${STATIC_ASSET_VERSION}`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_DEFAULT_TITLE}
      href={`${Astro.site}rss.xml`}
    />
    <Seo
      title={seoTitle}
      description={seoDescription}
      canonical={canonicalUrl}
      openGraph={openGraph}
      structuredData={structuredData}
    />

    <slot name="head" />
  </head>

  <body
    class:list={[bodyClass, { "reading-progress-disabled": !readingProgress }]}
    data-bare-page={barePage ? "true" : undefined}
    data-reading-progress={readingProgress ? "on" : "off"}
    data-speed-insights-enabled={shouldLoadSpeedInsights ? "true" : undefined}
    data-speed-insights-route={shouldLoadSpeedInsights ? speedInsightsRoute : undefined}
    data-speed-insights-version={shouldLoadSpeedInsights ? speedInsightsVersion : undefined}
  >
    <script
      is:inline
      define:vars={{
        explicitContentCookieName,
        explicitContentStorageKey,
      }}
    >
      (() => {
        const readCookie = (name) => {
          const encodedName = `${encodeURIComponent(name)}=`;
          const cookie = document.cookie
            .split(";")
            .map((part) => part.trim())
            .find((part) => part.startsWith(encodedName));

          if (!cookie) return null;

          try {
            return decodeURIComponent(cookie.slice(encodedName.length));
          } catch {
            return null;
          }
        };
        const hasExplicitContentAcknowledgement = () => {
          try {
            const parsed = JSON.parse(localStorage.getItem(explicitContentStorageKey) || "null");
            if (parsed?.version === 1 && parsed.acknowledged === true) return true;
          } catch {}

          return readCookie(explicitContentCookieName) === "acknowledged";
        };
        const blockPreConsentInteraction = (event) => {
          if (!document.documentElement.classList.contains("consent-prelock")) return;
          if (event.target?.closest?.("site-cookie-consent-banner, .cookie-consent")) return;

          event.preventDefault();
          event.stopPropagation();
          event.stopImmediatePropagation?.();
        };

        const isBarePage = document.body.dataset.barePage === "true";

        if (!isBarePage && !hasExplicitContentAcknowledgement()) {
          document.documentElement.classList.add(
            "interaction-disabled",
            "consent-prelock",
            "consent-visible",
          );
          document.addEventListener("click", blockPreConsentInteraction, true);
          document.addEventListener("pointerdown", blockPreConsentInteraction, true);
          document.addEventListener("submit", blockPreConsentInteraction, true);
          document.addEventListener("keydown", blockPreConsentInteraction, true);
        }
      })();
    </script>
    {
      !barePage && (
        <a class="skip-link" href="#main-content">
          Aller au contenu
        </a>
      )
    }
    {!barePage && <Header />}
    <main id="main-content" class="site-main" tabindex="-1">
      <div class="site-content">
        <slot name="content" />
      </div>
    </main>
    {!barePage && <Footer />}
    {!barePage && <CookieConsentBanner />}
    {!barePage && <PageLoadingIndicator />}
    {!barePage && <SiteTooltip />}
    {!barePage && shouldEnhanceContent && <ImagePreview />}
    {!barePage && readingProgress && <ScrollTopButton />}
    {!barePage && <script>import "@/assets/js/app-bootstrap";</script>}
    {shouldEnhanceContent && <script>import "@/assets/js/content-enhancements.js";</script>}
  </body>
</html>
