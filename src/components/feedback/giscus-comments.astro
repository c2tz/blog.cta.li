---
interface Props {
  repo?: string;
  repoId?: string;
  category?: string;
  categoryId?: string;
  mapping?: string;
  strict?: string;
  reactionsEnabled?: string;
  emitMetadata?: string;
  inputPosition?: string;
  lang?: string;
}

const {
  repo = "",
  repoId = "",
  category = "",
  categoryId = "",
  mapping = "pathname",
  strict = "0",
  reactionsEnabled = "1",
  emitMetadata = "0",
  inputPosition = "bottom",
  lang = "fr",
} = Astro.props;
const configured = Boolean(repo.trim() && repoId.trim() && category.trim() && categoryId.trim());
---

<section
  class="giscus-comments"
  aria-labelledby="commentaires"
  data-pagefind-ignore
  data-giscus-comments
  data-repo={repo}
  data-repo-id={repoId}
  data-category={category}
  data-category-id={categoryId}
  data-mapping={mapping}
  data-strict={strict}
  data-reactions-enabled={reactionsEnabled}
  data-emit-metadata={emitMetadata}
  data-input-position={inputPosition}
  data-lang={lang}
  data-configured={String(configured)}
>
  <header class="giscus-comments-header">
    <div class="giscus-comments-intro">
      <h2 id="commentaires">
        <a href="#commentaires" class="heading-link">Commentaires</a>
      </h2>
      <p>
        Une question, une correction ou un retour ? Participez à la discussion dans le respect du
        code de conduite.
      </p>
    </div>
    <div class="giscus-comments-actions">
      <md-text-button
        class="giscus-comments-conduct-link"
        href="https://raw.githubusercontent.com/c2tz/ct-blog-comments/refs/heads/main/CODE_OF_CONDUCT.md"
        target="_blank"
        aria-label="Code de conduite (nouvel onglet)"
        has-icon
      >
        <md-icon slot="icon" aria-hidden="true">&#xE89E;</md-icon>
        Code de conduite
      </md-text-button>
      <md-filled-tonal-button
        type="button"
        class="giscus-comments-accept-button"
        data-giscus-accept
        disabled
      >
        J’accepte
      </md-filled-tonal-button>
    </div>
  </header>

  {
    !configured && (
      <p id="giscus-comments-config" class="giscus-comments-config">
        Configuration Giscus en attente : ajoutez le repo public, le repo ID, la catégorie et le
        category ID.
      </p>
    )
  }

  <p class="giscus-comments-config giscus-comments-privacy" data-giscus-privacy>
    Les commentaires sont masqués, car les services optionnels sont désactivés.{" "}
    <a href="/cookies/#modifier-vos-choix-cookies">Modifier mes préférences</a>.
  </p>

  <div class="giscus-comments-panel-content" data-giscus-panel aria-busy="false" hidden>
    <md-linear-progress
      class="giscus-comments-progress"
      data-giscus-progress
      indeterminate
      four-color
      aria-label="Chargement des commentaires"
      aria-hidden="true"></md-linear-progress>
    <p class="giscus-comments-error" data-giscus-error hidden>
      Les commentaires ne sont pas disponibles pour le moment.
    </p>
    <div class="giscus-comments-frame" data-giscus-frame></div>
  </div>
</section>

<script>
  import "@/assets/js/app/giscus-comments";
</script>

<style>
  .giscus-comments {
    display: block;
    padding-block-start: 1rem;
    color: var(--site-text);
  }

  .giscus-comments-config,
  .giscus-comments-error {
    margin-block: 1em;
    color: inherit;
    font-size: 1rem;
    line-height: 1.5rem;
  }

  .giscus-comments-config {
    color: var(--site-text);
  }

  .giscus-comments-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
  }

  .giscus-comments-intro {
    min-width: 0;
  }

  .giscus-comments-intro h2 {
    scroll-margin-block-start: 5rem;
  }

  .giscus-comments-actions {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .giscus-comments-conduct-link,
  .giscus-comments-accept-button {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .giscus-comments-panel-content {
    position: relative;
    min-height: 7rem;
    padding-block-start: 1rem;
  }

  .giscus-comments-progress {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    --md-linear-progress-active-indicator-color: var(--site-link);
    --md-linear-progress-active-indicator-height: 0.25rem;
    --md-linear-progress-track-color: var(--md-sys-color-surface-container-highest);
    --md-linear-progress-track-height: 0.25rem;
    --md-linear-progress-track-shape: var(--md-sys-shape-corner-none);
  }

  .giscus-comments-progress:not([data-loading-active]) {
    visibility: hidden;
  }

  .giscus-comments-frame {
    min-width: 0;
  }

  .giscus-comments-error {
    color: var(--md-sys-color-error);
  }

  @media (max-width: 700px) {
    .giscus-comments-header {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .giscus-comments-actions {
      flex-wrap: nowrap;
      justify-content: center;
      width: 100%;
      margin-inline: auto;
      text-align: center;
    }
  }
</style>
