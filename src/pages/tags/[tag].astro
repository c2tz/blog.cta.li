---
import TagPosts from "@/components/tags/tag-posts.astro";
import Layout from "@/layouts/site-layout.astro";
import { getListedBlogPostsWithGitDates } from "@/lib/blog-posts";
import { formatFrenchDate, formatFrenchDateTime, toDate } from "@/lib/date-format.mjs";

export async function getStaticPaths() {
  const allPosts = await getListedBlogPostsWithGitDates();

  const contentTags = [
    ...new Set(
      allPosts
        .flatMap((post) => post.data.tags)
        .filter((tag): tag is string => tag !== undefined && tag !== "all"),
    ),
  ].sort();
  const uniqueTags = ["all", ...contentTags];

  return uniqueTags.map((tag) => {
    const filteredPosts =
      tag === "all"
        ? allPosts
        : allPosts.filter((post) => post.data.tags && post.data.tags.includes(tag));

    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const tag = Astro.params.tag ?? "all";
const { posts } = Astro.props;
const isAllPosts = tag === "all";
const pageTitle = isAllPosts ? "Tous les articles" : `Articles avec le tag « ${tag} »`;
const tagPosts = posts.map((post) => ({
  createdIso: toDate(post.gitDates.createdAt).toISOString(),
  createdLabelCompact: formatFrenchDate(post.gitDates.createdAt),
  createdLabelFull: formatFrenchDateTime(post.gitDates.createdAt),
  title: post.data.title,
  url: `/posts/${post.id}/`,
}));
---

<Layout title={pageTitle} bodyClass="tag-page" readingProgress={false}>
  <Fragment slot="content">
    <section aria-labelledby="tag-posts-title">
      <h1 id="tag-posts-title">{pageTitle}</h1>
      <TagPosts posts={tagPosts} tag={tag} view="table" />
    </section>
  </Fragment>
</Layout>
