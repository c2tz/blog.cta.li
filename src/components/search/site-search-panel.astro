---
import { SORT_OPTIONS } from "./site-search-model";

interface Props {
  deferred?: boolean;
  idPrefix?: string;
}

const { deferred = false, idPrefix = "site-search-panel" } = Astro.props;
const resultsId = `${idPrefix}-results`;
const tagsId = `${idPrefix}-tags`;
const statusId = `${idPrefix}-status`;
const limitId = `${idPrefix}-filter-limit`;
const sortTriggerId = `${idPrefix}-sort-trigger`;
const sortMenuId = `${idPrefix}-sort-menu`;
---

<section
  class="site-search-panel"
  data-site-search-panel
  data-deferred={deferred ? "true" : "false"}
>
  <form class="site-search-panel-form" role="search" data-search-form>
    <div class="site-search-panel-field">
      <div class="site-search-panel-query">
        <md-filled-text-field
          id={`${idPrefix}-query`}
          name="query"
          class="site-search-panel-input"
          type="search"
          placeholder="Mot-clé, titre ou contenu"
          aria-label="Mot-clé, titre ou contenu"
          autocomplete="off"
          spellcheck="false"
          has-leading-icon
          aria-controls={`${resultsId} ${tagsId}`}
          aria-describedby={`${statusId} ${limitId}`}
          data-search-input
        >
          <md-icon slot="leading-icon" aria-hidden="true">&#xE8B6;</md-icon>
        </md-filled-text-field>

        <md-icon-button
          class="site-search-panel-clear-search"
          type="button"
          data-tooltip="Effacer la recherche"
          aria-label="Effacer la recherche"
          data-clear-search
          hidden
        >
          <md-icon aria-hidden="true">&#xE5CD;</md-icon>
        </md-icon-button>
      </div>

      <md-divider class="site-search-panel-divider" aria-hidden="true"></md-divider>
      <div class="site-search-panel-sort-control" data-sort-control>
        <md-text-button
          id={sortTriggerId}
          class="site-search-panel-sort-trigger"
          type="button"
          trailing-icon
          aria-label="Trier les résultats, Pertinence"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls={sortMenuId}
          data-sort-trigger
        >
          <span class="site-search-panel-sort-copy">
            <span class="site-search-panel-sort-label">Tri par</span>
            <span class="site-search-panel-sort-value" data-sort-value-label>Pertinence</span>
          </span>
          <svg
            slot="icon"
            class="site-search-panel-sort-arrow"
            viewBox="0 0 24 24"
            width="24"
            height="24"
            focusable="false"
            aria-hidden="true"
          >
            <path d="M7 10l5 5 5-5z"></path>
          </svg>
        </md-text-button>

        <md-menu
          id={sortMenuId}
          class="site-material-menu site-search-panel-sort-menu"
          anchor={sortTriggerId}
          anchor-corner="end-end"
          menu-corner="start-end"
          positioning="popover"
          quick
          aria-label="Tri par"
          data-sort-menu
        >
          {
            SORT_OPTIONS.map((option) => (
              <md-menu-item
                type="button"
                class="site-material-menu-item site-search-panel-sort-option"
                aria-label={option.accessibleLabel}
                data-sort-value={option.value}
                data-sort-accessible-label={option.accessibleLabel}
                data-selected-sort={!deferred && option.value === "relevance" ? "" : undefined}
              >
                <span slot="headline">{option.label}</span>
                <md-icon slot="end" class="site-search-panel-sort-check" aria-hidden="true">
                  &#xE5CA;
                </md-icon>
              </md-menu-item>
            ))
          }
        </md-menu>
      </div>
    </div>
  </form>

  <div class="site-search-panel-state" data-search-state>
    <p
      id={statusId}
      class="site-search-panel-status"
      role="status"
      aria-live="polite"
      data-search-status
    >
      Tapez au moins deux caractères ou choisissez un filtre.
    </p>

    <div class="site-search-panel-filter-actions" data-filter-actions hidden>
      <md-text-button
        class="site-search-panel-filter-button site-search-panel-clear-filters"
        type="button"
        has-icon
        aria-label="Effacer les filtres sélectionnés"
        data-clear-filters
      >
        <md-icon slot="icon" aria-hidden="true">&#xE5CD;</md-icon>
        <span>Effacer filtres</span>
      </md-text-button>
    </div>

    <p
      id={limitId}
      class="site-search-panel-filter-limit"
      role="status"
      aria-live="polite"
      data-filter-limit
      hidden
    >
      Limite atteinte : 3 tags maximum.
    </p>

    <md-linear-progress
      class="site-search-panel-progress"
      aria-label="Recherche en cours"
      indeterminate
      four-color
      aria-hidden="true"
      data-search-progress></md-linear-progress>
  </div>

  <div class="site-search-panel-filters">
    <md-chip-set
      id={tagsId}
      class="site-search-panel-tags"
      aria-label="Filtrer par tags"
      data-search-tags
      hidden></md-chip-set>
  </div>

  <ol id={resultsId} class="site-search-panel-results" data-search-results></ol>
</section>
