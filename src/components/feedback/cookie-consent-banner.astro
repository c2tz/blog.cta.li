---
import "@/assets/css/components/cookie-consent.scss";
---

<site-cookie-consent-banner>
  <template data-cookie-template="explicit-content">
    <div data-cookie-active-notice>
      <div class="cookie-consent-backdrop cookie-consent-backdrop--modal" aria-hidden="true"></div>
      <section
        class="cookie-consent cookie-consent--modal cookie-consent--explicit-content"
        role="dialog"
        aria-modal="true"
        aria-labelledby="explicit-content-consent-title"
        aria-describedby="explicit-content-age-help"
      >
        <div class="cookie-consent-alert">
          <svg
            class="cookie-consent-boot-warning-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 -960 960 960"
            aria-hidden="true"
          >
            <path
              d="m40-120 440-760 440 760H40Zm468.5-131.5Q520-263 520-280t-11.5-28.5Q497-320 480-320t-28.5 11.5Q440-297 440-280t11.5 28.5Q463-240 480-240t28.5-11.5ZM440-360h80v-200h-80v200Z"
            ></path>
          </svg>
          <div class="cookie-consent-content">
            <h4 id="explicit-content-consent-title">Avertissement images explicites +18</h4>
            <p>
              Ce site peut inclure et proposer l'affichage de contenu : <strong
                ><u>image d'anime explicite</u></strong
              > ; qui n'est pas approprié pour tous les âges ou pour la consultation au travail (NSFW).
            </p>
            <div class="cookie-consent-age-field">
              <md-outlined-text-field
                id="explicit-content-age"
                name="explicit-content-age"
                type="date"
                min="1900-01-01"
                autocomplete="bday"
                label="Date de naissance"
                aria-describedby="explicit-content-age-help"
                data-cookie-age></md-outlined-text-field>
              <span id="explicit-content-age-help" class="sr-only">
                Vous devez avoir au moins 18 ans pour activer le bouton Continuer.
              </span>
              <span
                class="cookie-consent-age-status"
                role="status"
                aria-live="polite"
                data-cookie-age-status></span>
            </div>
          </div>
        </div>

        <div class="cookie-consent-actions">
          <md-text-button
            class="cookie-consent-return-action"
            type="button"
            aria-label="Quitter le site"
            data-cookie-action="leave"
          >
            QUITTER
          </md-text-button>
          <md-filled-button
            class="cookie-consent-confirm-action"
            type="button"
            aria-label="J’accepte et j’entre en confirmant avoir au moins 18 ans"
            data-cookie-action="acknowledge"
            disabled
          >
            CONTINUER
          </md-filled-button>
        </div>
      </section>
    </div>
  </template>

  <template data-cookie-template="privacy">
    <div data-cookie-active-notice>
      <section
        class="cookie-consent cookie-consent--privacy"
        aria-label="Avis de confidentialité"
        aria-describedby="cookie-consent-desc"
      >
        <div class="cookie-consent-content">
          <p id="cookie-consent-desc">
            Choisissez les services optionnels utilisés par ce site, ou personnalisez-les un par un.
          </p>
        </div>

        <div class="cookie-consent-actions cookie-consent-actions--desktop">
          <md-text-button
            class="cookie-consent-details-action"
            href="/cookies/#modifier-vos-choix-cookies">PLUS DE DÉTAILS</md-text-button
          >
          <div class="cookie-consent-choice-actions">
            <md-text-button type="button" data-cookie-action="reject">TOUT REFUSER</md-text-button>
            <md-text-button type="button" data-cookie-action="accept">TOUT ACCEPTER</md-text-button>
          </div>
        </div>
        <div class="cookie-consent-actions cookie-consent-actions--mobile">
          <md-text-button type="button" data-cookie-action="reject"> TOUT REFUSER </md-text-button>
          <md-text-button type="button" data-cookie-action="accept">TOUT ACCEPTER</md-text-button>
        </div>
      </section>
    </div>
  </template>
</site-cookie-consent-banner>

<script is:inline>
  (() => {
    if (!document.documentElement.classList.contains("consent-prelock")) return;
    const banner = document.currentScript?.previousElementSibling;
    if (!banner || banner.querySelector("[data-cookie-active-notice]")) return;
    const template = banner.querySelector('[data-cookie-template="explicit-content"]');
    if (!(template instanceof HTMLTemplateElement)) return;
    const notice = template.content.firstElementChild?.cloneNode(true);
    if (!(notice instanceof HTMLElement)) return;
    notice.setAttribute("data-cookie-boot-notice", "");
    banner.append(notice);
  })();
</script>
