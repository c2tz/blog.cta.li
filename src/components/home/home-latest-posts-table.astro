---
import "@/assets/css/components/home-latest-posts.scss";
import type { HomeLatestPost } from "@/lib/blog-post-projections.mjs";
import { SORT_INDICATOR_HTML } from "@/assets/js/app/table-sort";

interface Props {
  detailEndpoint?: string;
  posts: readonly HomeLatestPost[];
}

const { detailEndpoint = "/latest-posts.json", posts } = Astro.props;
const initialPosts = posts.slice(0, 3);
---

<site-home-latest-posts-table
  data-detail-endpoint={detailEndpoint}
  data-posts={JSON.stringify(initialPosts)}
>
  <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-sort-status></p>
  <p role="status" aria-live="polite" aria-atomic="true" data-load-status hidden></p>

  <div class="home-posts-table-scroll" tabindex="0" data-table-scroll>
    <md-linear-progress
      class="home-posts-table-progress"
      indeterminate
      four-color
      aria-label="Chargement des articles"
      aria-hidden="true"
      data-loading-progress></md-linear-progress>

    <table
      id="home-latest-posts-table"
      class="home-posts-table"
      aria-label="Derniers articles"
      data-posts-table
    >
      <thead>
        <tr>
          <th class="home-posts-date-column" scope="col">
            <button
              type="button"
              class="home-posts-sort-button"
              aria-label="Trier par date de création"
              data-sort-column="date"
            >
              <span>Date de création</span>
              <Fragment set:html={SORT_INDICATOR_HTML} />
              <md-ripple></md-ripple>
            </button>
          </th>
          <th class="home-posts-title-column home-posts-title-header" scope="col">
            <button
              type="button"
              class="home-posts-sort-button"
              aria-label="Trier par titre"
              data-sort-column="title"
            >
              <span>Titre</span>
              <Fragment set:html={SORT_INDICATOR_HTML} />
              <md-ripple></md-ripple>
            </button>
          </th>
        </tr>
      </thead>
      <tbody data-posts-body>
        {
          initialPosts.length > 0 ? (
            initialPosts.map((post) => (
              <tr class="home-posts-table-row">
                <td class="home-posts-date-column">
                  <time
                    class="post-date site-date-compact home-post-date-compact"
                    datetime={post.datetime}
                  >
                    {post.dateCompact}
                  </time>
                  <time
                    class="post-date site-date-full home-post-date-full"
                    datetime={post.datetime}
                  >
                    {post.dateFull}
                  </time>
                </td>
                <td class="home-posts-title-column">
                  <a class="home-post-title" href={post.href}>
                    {post.title}
                  </a>
                </td>
              </tr>
            ))
          ) : (
            <tr class="home-posts-table-loading-row">
              <td colspan="2">
                <span class="home-posts-table-empty">Aucun article à afficher.</span>
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
</site-home-latest-posts-table>
