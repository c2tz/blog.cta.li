---
import SiteSearchPanel from "./site-search-panel.astro";
import "@/assets/css/components/site-search-trigger.scss";

const dialogId = "site-search-dialog";
---

<div class="site-search-trigger" data-site-search-trigger>
  <md-icon-button
    type="button"
    class="site-search-trigger-button"
    data-tooltip="Rechercher"
    data-tooltip-suppress-expanded
    aria-label="Rechercher"
    aria-keyshortcuts="Control+K Meta+K"
    aria-haspopup="dialog"
    aria-controls={dialogId}
    data-search-open
  >
    <md-icon aria-hidden="true" data-search-open-icon>&#xE8B6;</md-icon>
    <md-circular-progress
      class="site-search-trigger-progress"
      indeterminate
      four-color
      aria-hidden="true"
      data-search-open-progress
      hidden></md-circular-progress>
  </md-icon-button>

  <md-dialog id={dialogId} class="site-search-dialog" aria-label="Recherche" data-search-dialog>
    <div slot="content" class="site-search-dialog-content">
      <div class="site-search-dialog-header">
        <h2>Recherche</h2>
        <md-icon-button
          type="button"
          data-tooltip="Fermer la recherche"
          aria-label="Fermer la recherche"
          data-search-close
        >
          <md-icon aria-hidden="true">&#xE5CD;</md-icon>
        </md-icon-button>
      </div>
      <SiteSearchPanel idPrefix="site-search-dialog-panel" deferred />
    </div>
  </md-dialog>
</div>
