---
import { SITE_TITLE } from "@/site-config";

const COPYRIGHT_YEAR = 2025;
const STATIC_ASSET_VERSION = "20260704";
---

<footer class="site-footer">
  <a href="/" class="site-footer-logo" aria-label={`Accueil de ${SITE_TITLE}`}>
    <img
      src={`/mask.webp?v=${STATIC_ASSET_VERSION}`}
      alt="Logo de c2tz"
      width="60"
      height="60"
      loading="lazy"
      decoding="async"
      data-no-image-link
    />
  </a>

  <nav aria-label="Liens externes">
    <ul class="site-footer-social-links">
      <li>
        <a
          class="site-footer-link"
          href="https://bsky.app/profile/c2tz.bsky.social"
          target="_blank"
          rel="noopener noreferrer">Bluesky</a
        >
      </li>
      <li>
        <a
          class="site-footer-link"
          href="https://github.com/c2tz"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
      </li>
      <li>
        <a
          class="site-footer-link"
          href="https://www.komoot.com/fr-fr/user/1042380125464"
          target="_blank"
          rel="noopener noreferrer">Komoot</a
        >
      </li>
      <li>
        <a
          class="site-footer-link"
          href="https://matrix.to/#/@c2tz:matrix.org"
          target="_blank"
          rel="noopener noreferrer">Matrix</a
        >
      </li>
      <li>
        <a
          class="site-footer-link"
          href="https://youtube.com/@c2tz"
          target="_blank"
          rel="noopener noreferrer">YouTube</a
        >
      </li>
      <li>
        <a
          class="site-footer-link"
          href="https://blog.cta.li/"
          target="_blank"
          rel="noopener noreferrer">Blog</a
        >
      </li>
      <li>
        <a
          class="site-footer-link"
          href="https://ct-nas.cta.li/"
          target="_blank"
          rel="noopener noreferrer">ct-nas</a
        >
      </li>
      <li><a class="site-footer-link" href="mailto:contact@cta.li">E-mail</a></li>
    </ul>
  </nav>

  <p class="site-footer-meta">
    <a class="site-footer-link" href="/LICENSE.txt" target="_blank" rel="noopener noreferrer"
      >MIT License</a
    >
    {" "}
    {COPYRIGHT_YEAR}
    <span class="site-footer-separator" aria-hidden="true">•</span>
    <a class="site-footer-link" href={`https://${SITE_TITLE}/`}>{SITE_TITLE}</a>
    <span class="site-footer-separator" aria-hidden="true">•</span>
    <a href="/cookies/" class="site-footer-link">Données personnelles</a>

    <span id="ip-wrapper" hidden>
      <span class="site-footer-separator" aria-hidden="true">•</span>
      Votre IP : <strong id="client-ip">—</strong>
      <span id="client-location-details" hidden>
        {" "}(<span id="client-country"></span><span id="client-network" hidden></span>)
      </span>
    </span>
  </p>
</footer>
