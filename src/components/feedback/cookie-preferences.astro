---
interface Props {
  labelledby?: string;
}

const { labelledby = "modifier-vos-choix-cookies" } = Astro.props;
---

<site-cookie-preferences class="not-prose">
  <section
    class="cookie-preferences-panel"
    aria-labelledby={labelledby}
    data-cookie-preference-state="unset"
  >
    <header class="cookie-preferences-header">
      <div class="cookie-preferences-heading">
        <p class="cookie-preferences-title">Services optionnels</p>
        <p class="cookie-preferences-description">
          Choisissez séparément les services que vous souhaitez activer.
        </p>
      </div>
      <strong
        class="cookie-preferences-status"
        data-cookie-preferences-status
        role="status"
        aria-live="polite"
      >
        Aucun choix enregistré
      </strong>
    </header>

    <md-divider></md-divider>

    <div class="cookie-preferences-services" aria-label="Services optionnels">
      <section class="cookie-preferences-service">
        <div class="cookie-preferences-service-copy">
          <p class="cookie-preferences-service-title">Commentaires Giscus</p>
          <p class="cookie-preferences-service-description">
            Autorise le service de commentaires sur les articles. Vous gardez ensuite le choix de le
            charger sur chaque page.
          </p>
        </div>
        <md-switch
          data-cookie-preference-service="giscus"
          aria-label="Commentaires Giscus. Autorise le service de commentaires sur les articles. Vous gardez ensuite le choix de le charger sur chaque page."
        ></md-switch>
      </section>

      <section class="cookie-preferences-service">
        <div class="cookie-preferences-service-copy">
          <p class="cookie-preferences-service-title">Géolocalisation IP</p>
          <p class="cookie-preferences-service-description">
            Interroge ipapi.is pour afficher votre pays, votre ASN et votre réseau dans le pied de
            page.
          </p>
        </div>
        <md-switch
          data-cookie-preference-service="ipgeo"
          aria-label="Géolocalisation IP. Interroge ipapi.is pour afficher votre pays, votre ASN et votre réseau dans le pied de page."
        ></md-switch>
      </section>

      <section class="cookie-preferences-service">
        <div class="cookie-preferences-service-copy">
          <p class="cookie-preferences-service-title">Mesure des performances Vercel</p>
          <p class="cookie-preferences-service-description">
            Autorise Vercel Speed Insights à mesurer les performances de navigation en production.
          </p>
        </div>
        <md-switch
          data-cookie-preference-service="speed-insights"
          aria-label="Mesure des performances Vercel. Autorise Vercel Speed Insights à mesurer les performances de navigation en production."
        ></md-switch>
      </section>
    </div>

    <div
      class="cookie-preferences-actions"
      role="group"
      aria-label="Actions sur les services optionnels"
    >
      <div class="cookie-preferences-choice-actions">
        <md-filled-button
          class="cookie-preferences-choice cookie-preferences-reject"
          type="button"
          aria-label="Refuser les services optionnels"
          data-cookie-preference-action="reject-all"
          has-icon
        >
          <md-icon slot="icon" aria-hidden="true">&#xE5CD;</md-icon>
          Tout refuser
        </md-filled-button>
        <md-filled-tonal-button
          class="cookie-preferences-choice cookie-preferences-allow"
          type="button"
          aria-label="Autoriser les services optionnels"
          data-cookie-preference-action="accept-all"
          has-icon
        >
          <md-icon slot="icon" aria-hidden="true">&#xE5CA;</md-icon>
          Tout autoriser
        </md-filled-tonal-button>
      </div>
      <md-text-button
        class="cookie-preferences-reset"
        type="button"
        aria-label="Réinitialiser le choix des services optionnels"
        data-cookie-preference-action="reset"
      >
        Réinitialiser
      </md-text-button>
    </div>
    <p
      class="cookie-preferences-feedback"
      data-cookie-preferences-feedback
      role="status"
      aria-live="polite"
    >
    </p>
  </section>
</site-cookie-preferences>

<script>
  import "@/assets/js/material-web/cookies.js";
  import { defineCookieConsentControls } from "@/assets/js/app/cookie-consent-controls.js";

  defineCookieConsentControls();
</script>
