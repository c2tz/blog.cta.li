---
const CLOSE_ICON = "\uE5CD";
const DOWNLOAD_ICON = "\uE2C4";
const FULLSCREEN_ICON = "\uE5D0";
const INFO_ICON = "\uE88E";
const SHARE_ICON = "\uE80D";
---

<md-dialog
  id="site-image-preview-dialog"
  class="site-image-dialog"
  aria-label="Aperçu de l’image"
  data-site-image-dialog
>
  <div slot="content" class="site-image-dialog-shell" data-image-dialog-shell>
    <div class="site-image-dialog-stage" data-image-dialog-stage>
      <img
        class="site-image-dialog-image"
        data-image-dialog-image
        alt=""
        decoding="async"
        draggable="false"
      />
    </div>

    <div
      class="site-image-dialog-toolbar"
      role="toolbar"
      aria-label="Commandes de l’image"
      data-image-dialog-toolbar
    >
      <md-icon-button
        type="button"
        aria-label="Afficher les informations"
        data-tooltip="Afficher les informations"
        aria-controls="site-image-information-dialog"
        aria-expanded="false"
        aria-haspopup="dialog"
        touch-target="wrapper"
        data-image-information
      >
        <md-icon aria-hidden="true">{INFO_ICON}</md-icon>
      </md-icon-button>

      <md-icon-button
        type="button"
        aria-label="Fermer"
        data-tooltip="Fermer"
        touch-target="wrapper"
        autofocus
        data-image-close
      >
        <md-icon aria-hidden="true">{CLOSE_ICON}</md-icon>
      </md-icon-button>
    </div>

    <span class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-image-status
    ></span>
  </div>
</md-dialog>

<md-dialog
  id="site-image-information-dialog"
  class="site-image-information-dialog"
  aria-label="Informations sur l’image"
  data-image-information-dialog
>
  <section slot="content" class="site-image-information">
    <header class="site-image-information-header">
      <h2 id="site-image-information-title">Informations sur l’image</h2>
      <md-icon-button
        type="button"
        aria-label="Fermer les informations"
        data-tooltip="Fermer les informations"
        data-tooltip-suppress-pointer-focus
        touch-target="wrapper"
        autofocus
        data-image-information-close
      >
        <md-icon aria-hidden="true">{CLOSE_ICON}</md-icon>
      </md-icon-button>
    </header>

    <dl class="site-image-information-list">
      <div><dt>Nom</dt><dd data-image-info-name></dd></div>
      <div><dt>Format affiché</dt><dd data-image-info-type></dd></div>
      <div>
        <dt>Taille chargée</dt><dd role="status" aria-live="polite" data-image-info-size></dd>
      </div>
      <div><dt>Dimensions</dt><dd data-image-info-dimensions></dd></div>
      <div><dt>Ajoutée le</dt><dd data-image-info-created></dd></div>
      <div><dt>Modifiée le</dt><dd data-image-info-modified></dd></div>
    </dl>
  </section>

  <div slot="actions" class="site-image-information-actions">
    <md-text-button type="button" data-image-download>
      <md-icon slot="icon" aria-hidden="true">{DOWNLOAD_ICON}</md-icon>
      Télécharger
    </md-text-button>
    <md-text-button type="button" data-image-share>
      <md-icon slot="icon" aria-hidden="true">{SHARE_ICON}</md-icon>
      <span data-image-share-label>Partager</span>
    </md-text-button>
    <md-text-button type="button" data-image-fullscreen hidden>
      <md-icon slot="icon" aria-hidden="true">{FULLSCREEN_ICON}</md-icon>
      <span data-image-fullscreen-label>Plein écran</span>
    </md-text-button>
    <span
      class="sr-only"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-image-action-status></span>
  </div>
</md-dialog>

<script>
  import { installImagePreviewDialog } from "@/assets/js/app/image-preview.js";

  installImagePreviewDialog();
</script>
