---
import { SITE_TITLE } from "@/site-config";
import HomeDetailToggle from "@/components/home/home-detail-toggle.astro";
import SiteSearch from "@/components/search/site-search.astro";
import ThemeSwitcher from "./theme-switcher.astro";
---

<header class="site-header">
  <div class="site-header-title">
    <a href="/" class="header-link" aria-label={SITE_TITLE}>
      {SITE_TITLE}
    </a>
  </div>

  <div class="site-header-actions">
    <SiteSearch />
    <HomeDetailToggle />
    <ThemeSwitcher />
  </div>
</header>
