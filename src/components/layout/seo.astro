---
export interface OpenGraphData {
  title: string;
  type: "article" | "website";
  image: string;
  url?: string | URL;
  description?: string;
  publishedTime?: string;
  modifiedTime?: string;
  imageAlt?: string;
}

interface Props {
  canonical: string | URL;
  description: string;
  title: string;
  openGraph?: OpenGraphData;
  structuredData?: Record<string, unknown> | readonly Record<string, unknown>[];
}

const { canonical, description, title, openGraph, structuredData } = Astro.props;
const canonicalUrl = String(canonical);
const socialDescription = openGraph?.description ?? description;
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replaceAll("<", "\\u003c")
  : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
<meta name="theme-color" content="#F9F9FF" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
<link rel="canonical" href={canonicalUrl} />

{
  openGraph && (
    <>
      <meta property="og:title" content={openGraph.title} />
      <meta property="og:type" content={openGraph.type} />
      <meta property="og:image" content={openGraph.image} />
      <meta property="og:image:alt" content={openGraph.imageAlt ?? openGraph.title} />
      <meta property="og:url" content={openGraph.url ?? canonicalUrl} />
      <meta property="og:description" content={socialDescription} />
      <meta property="og:locale" content="fr_FR" />
      <meta property="og:site_name" content="ct-blog.cta.li" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={openGraph.title} />
      <meta name="twitter:description" content={socialDescription} />
      <meta name="twitter:image" content={openGraph.image} />
      <meta name="twitter:image:alt" content={openGraph.imageAlt ?? openGraph.title} />
      {openGraph.publishedTime && (
        <meta property="article:published_time" content={openGraph.publishedTime} />
      )}
      {openGraph.modifiedTime && (
        <meta property="article:modified_time" content={openGraph.modifiedTime} />
      )}
    </>
  )
}

{
  structuredDataJson && (
    <script is:inline type="application/ld+json" set:html={structuredDataJson} />
  )
}
