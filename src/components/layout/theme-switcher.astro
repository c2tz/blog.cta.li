---
const options = [
  { value: "system", label: "Système" },
  { value: "light", label: "Clair" },
  { value: "dark", label: "Sombre" },
] as const;
---

<div class="site-header-control" data-theme-switcher>
  <md-icon-button
    id="site-theme-trigger"
    type="button"
    class="site-theme-trigger"
    data-tooltip="Thème : Système"
    aria-label="Thème : Système"
    aria-expanded="false"
    aria-controls="site-theme-menu"
    aria-haspopup="menu"
  >
    <md-icon aria-hidden="true" data-theme-trigger-icon>&#xE1AB;</md-icon>
  </md-icon-button>

  <md-menu
    id="site-theme-menu"
    class="site-material-menu site-theme-menu"
    anchor="site-theme-trigger"
    anchor-corner="end-end"
    menu-corner="start-end"
    positioning="popover"
    aria-label="Choisir le thème"
  >
    {
      options.map((option) => (
        <md-menu-item
          type="button"
          class="site-material-menu-item site-theme-menu-item"
          data-theme-option={option.value}
          aria-label={option.label}
        >
          <md-icon slot="start" class="site-theme-radio-icon" aria-hidden="true">
            &#xE836;
          </md-icon>
          <span slot="headline" class="site-theme-menu-content">
            <svg
              class="site-theme-example-icon"
              width="25"
              height="24"
              viewBox="0 0 80 80"
              aria-hidden="true"
              focusable="false"
            >
              <defs>
                <clipPath id={`theme-swatch-${option.value}`}>
                  <rect width="80" height="80" rx="2.13" />
                </clipPath>
                <clipPath id={`theme-pill-${option.value}`}>
                  <rect x="20" y="40" width="40" height="12" rx="6" />
                </clipPath>
              </defs>
              <g clip-path={`url(#theme-swatch-${option.value})`}>
                <rect
                  width="80"
                  height="80"
                  class={
                    option.value === "dark"
                      ? "site-theme-swatch-surface-dark"
                      : "site-theme-swatch-surface-light"
                  }
                />
                {option.value === "system" && (
                  <rect x="40" width="40" height="80" class="site-theme-swatch-surface-dark" />
                )}
                <rect
                  width="80"
                  height="17.24"
                  class={
                    option.value === "dark"
                      ? "site-theme-swatch-primary-dark"
                      : "site-theme-swatch-primary-light"
                  }
                />
                {option.value === "system" && (
                  <rect x="40" width="40" height="17.24" class="site-theme-swatch-primary-dark" />
                )}
                <g clip-path={`url(#theme-pill-${option.value})`}>
                  <rect
                    x="20"
                    y="40"
                    width="40"
                    height="12"
                    class={
                      option.value === "dark"
                        ? "site-theme-swatch-primary-dark"
                        : "site-theme-swatch-primary-light"
                    }
                  />
                  {option.value === "system" && (
                    <rect
                      x="40"
                      y="40"
                      width="20"
                      height="12"
                      class="site-theme-swatch-primary-dark"
                    />
                  )}
                </g>
              </g>
              <rect
                x="0.5"
                y="0.5"
                width="79"
                height="79"
                rx="2.13"
                fill="none"
                stroke="currentColor"
                stroke-opacity="0.24"
              />
            </svg>
            <span>{option.label}</span>
            <span class="sr-only" data-theme-selected-label hidden>
              Thème sélectionné
            </span>
          </span>
        </md-menu-item>
      ))
    }
    <md-divider class="site-theme-menu-divider" data-dynamic-color-control hidden></md-divider>
    <div
      class="site-theme-dynamic-color-row"
      data-dynamic-color-control
      data-dynamic-color-option
      hidden
    >
      <span class="site-theme-dynamic-color-copy">
        <span>Couleur dynamique</span>
        <span class="site-theme-dynamic-color-support" data-dynamic-color-support>
          Chargez d’abord une image sur l’accueil
        </span>
      </span>
      <md-switch
        class="site-theme-dynamic-color-switch"
        touch-target="none"
        show-only-selected-icon
        aria-label="Couleur dynamique"
        disabled></md-switch>
    </div>
  </md-menu>

  <span class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-theme-status
  ></span>
</div>

<style>
  .site-header-control {
    position: relative;
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 2.5rem;
  }
</style>
