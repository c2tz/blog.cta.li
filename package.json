{
  "name": "astro-commit",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.22.3 || ^24.11.1 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm prepare:landing-assets && astro sync --force && astro dev",
    "dev:local": "pnpm prepare:landing-assets && astro sync --force && astro dev --host --port 4321",
    "build": "pnpm prepare:landing-assets && pnpm check:konachan-runtime && astro build && pnpm index:search && pnpm check:content && pnpm minify:html && pnpm check:bundles",
    "build:debug": "pnpm prepare:landing-assets && pnpm check:konachan-runtime && astro build && pnpm index:search && pnpm check:content",
    "build:test": "LANDING_ASSETS_SOURCE_DIR=tests/fixtures/landing-assets pnpm build",
    "build:vercel": "node scripts/ensure-git-history.mjs && pnpm build && pnpm check:headers",
    "preview": "astro preview",
    "preview:local": "astro preview --host 127.0.0.1 --port 4322",
    "test": "pnpm test:unit",
    "test:unit": "node --test tests/**/*.test.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/clean-lighthouse-reports.mjs && pnpm test:lighthouse:mobile && pnpm test:lighthouse:desktop",
    "test:lighthouse:mobile": "lhci autorun --config=./lighthouserc.cjs",
    "test:lighthouse:desktop": "lhci autorun --config=./lighthouserc.cjs --collect.settings.preset=desktop --collect.settings.throttling.cpuSlowdownMultiplier=1 --upload.outputDir=./lighthouse-reports/desktop",
    "theme:check": "tsx scripts/generate-material-theme.ts --check",
    "theme:generate": "tsx scripts/generate-material-theme.ts",
    "check": "astro check",
    "audit:dependencies": "pnpm audit --audit-level low",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check:knip": "knip --no-config-hints",
    "check:commits": "commitlint --from origin/develop --to HEAD --verbose",
    "sync:headers": "node scripts/sync-security-header-hashes.mjs",
    "check:headers": "node scripts/check-security-headers.mjs",
    "check:content": "node scripts/check-built-content.mjs",
    "check:bundles": "node scripts/check-bundle-budget.mjs",
    "check:konachan-runtime": "node scripts/check-konachan-runtime-manifest.mjs",
    "prepare:landing-assets": "node scripts/fetch-private-landing-assets.mjs",
    "verify": "pnpm verify:project",
    "verify:quality:static": "pnpm test:unit && pnpm theme:check && pnpm check && pnpm lint && pnpm audit:dependencies && pnpm check:material-symbols && pnpm check:knip && pnpm format:check && pnpm build:test && pnpm check:headers",
    "verify:quality": "pnpm verify:quality:static && PLAYWRIGHT_REUSE_BUILD=1 pnpm test:e2e",
    "verify:project": "pnpm verify:quality && pnpm test:lighthouse",
    "lint:commit": "commitlint",
    "index:search": "node scripts/clean-pagefind.mjs && pagefind --site dist --glob \"posts/**/index.html\" --silent && node scripts/prune-pagefind-output.mjs && node scripts/sync-pagefind-dev.mjs",
    "minify:html": "node scripts/minify-dist-html.mjs",
    "format": "node scripts/check-changed-format.mjs --write",
    "format:check": "node scripts/check-changed-format.mjs",
    "format:all": "prettier . --write",
    "format:all:check": "prettier . --check",
    "prepare": "husky",
    "astro": "astro",
    "new:post": "node scripts/new-post.mjs",
    "check:material-symbols": "node scripts/update-material-symbols.mjs --check",
    "update:material-symbol-map": "node scripts/generate-material-symbol-codepoints.mjs",
    "update:material-symbols": "node scripts/update-material-symbols.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@floating-ui/dom": "^1.8.0",
    "@material/material-color-utilities": "^0.4.0",
    "@material/web": "2.5.0",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.2.0",
    "fonteditor-core": "^2.6.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "satori": "0.29.0",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.3"
  },
  "packageManager": "pnpm@11.1.3",
  "volta": {
    "node": "22.22.3",
    "pnpm": "11.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@shikijs/transformers": "^4.4.2",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "^17.8.0",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "knip": "6.32.2",
    "lint-staged": "^17.3.0",
    "material-symbols": "^0.45.10",
    "pagefind": "^1.5.2",
    "parse5": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.102.0",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
