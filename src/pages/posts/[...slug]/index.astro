---
import { type CollectionEntry, getCollection, render } from "astro:content";

import GiscusComments from "@/components/feedback/giscus-comments.astro";
import PostGitDates from "@/components/post/post-git-dates.astro";
import Prose from "@/components/post/prose.astro";
import Layout from "@/layouts/site-layout.astro";
import "@/assets/css/components/code-block.scss";
import "@/assets/css/components/_image-dialog.scss";
import "@/assets/css/content/footnotes.scss";
import "@/assets/css/content/material-shortcodes.scss";
import "@/assets/css/content/post-meta.scss";
import "@/assets/css/content/prose.scss";
import { isListedBlogPost } from "@/lib/blog-posts";
import { getContentEntryGitDates } from "@/lib/git-dates.mjs";
import { SITE_GISCUS_CONFIG } from "@/site-config";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
const gitDates = getContentEntryGitDates("blog", post);
const isListed = isListedBlogPost(post);
const { createdAt, lastModified } = gitDates;
const postPriority = post.data.priority ?? 0;
const visiblePostTags = [...(post.data.tags ?? [])].filter((tag) => tag !== "all");
const postTags = visiblePostTags.map((tag) => ({
  label: `#${tag}`,
  value: tag,
}));
const postUrl = new URL(`/posts/${post.id}/`, Astro.site).toString();
const postImage = new URL(`/posts/${post.id}/og.png`, Astro.site).toString();
const postStructuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  image: postImage,
  datePublished: createdAt,
  dateModified: lastModified,
  inLanguage: "fr-FR",
  mainEntityOfPage: postUrl,
  author: {
    "@type": "Person",
    name: "c2tz",
    url: "https://www.cta.li/",
  },
  publisher: {
    "@type": "Person",
    name: "c2tz",
  },
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  structuredData={postStructuredData}
  openGraph={{
    title: post.data.title,
    type: "article",
    image: postImage,
    imageAlt: `Aperçu de l’article « ${post.data.title} »`,
    url: postUrl,
    description: post.data.description,
    publishedTime: createdAt,
    modifiedTime: lastModified,
  }}
>
  <Fragment slot="content">
    <article
      class="post"
      data-pagefind-body={isListed ? true : undefined}
      data-pagefind-ignore={isListed ? undefined : "all"}
    >
      <header class="post-header">
        <h1 id="post-title" class="post-title-anchor" data-anchor-reset>
          <a href="#post-title" class="heading-link">{post.data.title}</a>
        </h1>
      </header>
      <div class="post-search-metadata" data-pagefind-ignore aria-hidden="true">
        <time
          datetime={createdAt}
          data-pagefind-meta="created[datetime]"
          data-pagefind-sort="created[datetime]"
        >
          {createdAt}
        </time>
        <time
          datetime={lastModified}
          data-pagefind-meta="modified[datetime]"
          data-pagefind-sort="modified[datetime]"
        >
          {lastModified}
        </time>
        <span data-pagefind-meta="tags">
          {visiblePostTags.join(", ")}
        </span>
        <span data-pagefind-meta="priority">
          {postPriority}
        </span>
        {visiblePostTags.map((tag) => <span data-pagefind-filter="tag">{tag}</span>)}
      </div>
      <Prose>
        <Content />
      </Prose>
      <div class="post-meta-table" data-pagefind-ignore>
        <PostGitDates
          createdAt={createdAt}
          createdCommit={gitDates.createdCommit}
          lastModified={lastModified}
          lastModifiedCommit={gitDates.lastModifiedCommit}
        />
        {
          postTags.length > 0 && (
            <nav class="post-tags-section" aria-label="Tags de l’article">
              <ul class="post-tags">
                {postTags.map((tag) => (
                  <li>
                    {isListed ? (
                      <a class="post-tag-link" href={`/tags/${encodeURIComponent(tag.value)}/`}>
                        {tag.label}
                      </a>
                    ) : (
                      <span class="post-tag-label" data-post-tag-static>
                        {tag.label}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
      <GiscusComments
        repo={SITE_GISCUS_CONFIG.repo}
        repoId={SITE_GISCUS_CONFIG.repoId}
        category={SITE_GISCUS_CONFIG.category}
        categoryId={SITE_GISCUS_CONFIG.categoryId}
        mapping={SITE_GISCUS_CONFIG.mapping}
        strict={SITE_GISCUS_CONFIG.strict}
        reactionsEnabled={SITE_GISCUS_CONFIG.reactionsEnabled}
        emitMetadata={SITE_GISCUS_CONFIG.emitMetadata}
        inputPosition={SITE_GISCUS_CONFIG.inputPosition}
        lang={SITE_GISCUS_CONFIG.lang}
      />
      <noscript>
        <section class="giscus-comments-noscript" data-pagefind-ignore>
          <h2>Commentaires</h2>
          <p>
            Les commentaires externes nécessitent JavaScript et un accord pour les services
            optionnels. Vous pouvez consulter ou modifier votre choix sur la page
            <a href="/cookies/#modifier-vos-choix-cookies">Données personnelles</a>.
          </p>
        </section>
      </noscript>
    </article>
  </Fragment>
</Layout>
